{
  "manifest_version": 3,
  "name": "Unlimited Games — Free Browser Games",
  "short_name": "Unlimited Games",
  "version": "1.6.2",
  "description": "A mini game center that opens right below your toolbar icon. One click to play, no downloads or sign-in needed.",
  "homepage_url": "https://unlimitedgames.vercel.app",
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Unlimited Games — pick & play",
    "default_popup": "popup.html"
  },
  "permissions": [],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://unlimitedgames.vercel.app https://*.vercel.app;"
  }
}
